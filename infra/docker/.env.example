# Copy this file to .env in the same folder and set real values.
# .env is gitignored and will NOT be committed.
# If .env is absent, docker-compose falls back to dev-only defaults
# (see docker-compose.yml) - fine for local dev, NOT safe for production.

POSTGRES_USER=agencyadmin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=devliora

# Production-only (used by docker-compose.prod.yml)
JWT_SECRET_KEY=changeme_generate_a_32plus_char_random_secret
CORS_ALLOWED_ORIGIN=https://devliora.com
NEXT_PUBLIC_API_URL=https://devliora.com/api
